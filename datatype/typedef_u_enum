module fsm;
  typedef enum logic [1:0] {
    IDLE     = 2'b00,
    START    = 2'b01,
    TRANSFER = 2'b10,
    DONE     = 2'b11
  } state_t;
  state_t state;
  initial begin
    state = IDLE;
    $display("state = %s", state.name());

    state = TRANSFER;
    $display("state = %s", state.name());
  end
endmodule
