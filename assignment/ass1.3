//3) Function to sum 5 elements
module example;
    int arr[5];
    int result;
    function int sum_array(input int arr[5]);
        int sum;
        sum = 0;
        for (int i = 0; i < 5; i++) begin
            sum = sum + arr[i];
        end
        return sum;
    endfunction
    initial begin
        arr[0] = 10;
        arr[1] = 20;
        arr[2] = 30;
        arr[3] = 40;
        arr[4] = 50;
        result = sum_array(arr);
        $display("Sum = %0d", result);
    end
endmodule


